@page "/modules/{ResourceId}"
@inject HttpClient Http
@inject SessionService Session
<PageTitle>@module?.Title</PageTitle>
@if(module is null){<h1>بخش پیدا نشد</h1>}else if(!Session.Current.IsAuthenticated){<div class="access-view"><h1>ورود لازم است</h1><p>برای مشاهده این بخش وارد سامانه شوید.</p><a class="btn btn-primary" href="/login">ورود</a></div>}else if(!Session.Can($"{ResourceId}.list")){<div class="access-view"><h1>دسترسی غیرمجاز</h1><p>شما اجازه مشاهده این بخش را ندارید.</p></div>}else{
<header class="page-header"><div><span class="eyebrow">@module.MenuGroup</span><h1>@module.Title</h1><p>جستجو، مشاهده و مدیریت @module.Title</p></div>@if(Session.Can($"{ResourceId}.create")){<button class="btn btn-primary" @onclick="NewRecord">ایجاد @module.SingularTitle</button>}</header>
<div class="toolbar"><label for="search">جستجو</label><input id="search" @bind="query" placeholder="عبارت مورد نظر"/><button class="btn btn-secondary" @onclick="Load">جستجو</button></div>
@if(message is not null){<div class="alert alert-info" role="status">@message</div>}
<div class="table-wrap"><table><thead><tr>@foreach(var f in module.Fields.Take(4)){<th>@f.Label</th>}<th>عملیات</th></tr></thead><tbody>@foreach(var row in items){<tr>@foreach(var f in module.Fields.Take(4)){<td>@Display(row,f.Name)</td>}<td class="actions"><button class="btn btn-ghost" @onclick="()=>Open(row,false)">جزئیات</button>@if(Session.Can($"{ResourceId}.update")){<button class="btn btn-ghost" @onclick="()=>Open(row,true)">ویرایش</button>}@if(Session.Can($"{ResourceId}.delete")){<button class="btn btn-danger-soft" @onclick="()=>deleteTarget=row">حذف</button>}</td></tr>}</tbody></table></div><div class="pagination"><button disabled="@(page==1)" @onclick="Prev">قبلی</button><span>صفحه @(page)</span><button disabled="@(page*10>=total)" @onclick="Next">بعدی</button></div>
@if(selected is not null){<div class="modal-backdrop"><section class="dialog" role="dialog" aria-modal="true"><header><h2>@(editing?$"ویرایش {module.SingularTitle}":$"جزئیات {module.SingularTitle}")</h2><button aria-label="بستن" @onclick="Close">×</button></header><div class="tabs"><button class="active" @onclick="()=>showHistory=false">اطلاعات اصلی</button>@if(ResourceId=="inspections"&&Session.Can("inspections.approval-history.read")){<button @onclick="LoadHistory">سوابق تأیید</button>}</div>@if(showHistory){<div class="history">@if(history.Count==0){<p>سابقه‌ای ثبت نشده است.</p>}@foreach(var h in history){<p>@h</p>}</div>}else{<div class="detail-grid">@foreach(var f in module.Fields){<div class="field"><label>@f.Label</label>@if(editing){<input value="@Display(selected,f.Name)" @onchange="e=>Set(f.Name,e.Value?.ToString())"/>}else{<strong>@Display(selected,f.Name)</strong>}</div>}</div>}<footer>@if(ResourceId=="inspections"&&Session.Can("inspections.approve")){<button class="btn btn-success" @onclick="Approve">تأیید بازرسی</button>}@if(editing){<button class="btn btn-primary" @onclick="Save">ذخیره تغییرات</button>}<button class="btn btn-secondary" @onclick="Close">بستن</button></footer></section></div>}
@if(deleteTarget is not null){<div class="modal-backdrop"><section class="dialog" role="alertdialog"><h2>تأیید حذف</h2><p>آیا از حذف این رکورد مطمئن هستید؟</p><footer><button class="btn btn-danger" @onclick="Delete">حذف رکورد</button><button class="btn btn-secondary" @onclick="()=>deleteTarget=null">انصراف</button></footer></section></div>}}
@code { [Parameter]public string ResourceId{get;set;}="";ModuleDefinition? module;List<JsonObject> items=[];JsonObject? selected,deleteTarget;bool editing,showHistory;string query="";string? message;int page=1,total;List<string> history=[];
protected override async Task OnParametersSetAsync(){module=ClientFeatureCatalog.Modules.FirstOrDefault(x=>x.ResourceId==ResourceId);await Session.RefreshAsync();if(module is not null&&Session.Can($"{ResourceId}.list"))await Load();}
async Task Load(){var r=await Http.GetAsync($"api/{ResourceId}?q={Uri.EscapeDataString(query)}&page={page}&pageSize=10");if(r.StatusCode==System.Net.HttpStatusCode.Forbidden){await Session.RefreshAsync();message="دسترسی شما تغییر کرده است.";return;}var d=await r.Content.ReadFromJsonAsync<JsonObject>();items=d?["items"]?.AsArray().Select(x=>x!.AsObject()).ToList()??[];total=d?["total"]?.GetValue<int>()??0;}
string Display(JsonObject x,string n)=>x[n]?.ToString()??"—";void Set(string n,string? v){if(selected is not null)selected[n]=v;}void Open(JsonObject x,bool edit){selected=(JsonObject)x.DeepClone();editing=edit;}void NewRecord(){selected=new();editing=true;}void Close(){selected=null;showHistory=false;}
async Task Save(){if(selected is null)return;var id=selected["id"]?.GetValue<int>()??0;var r=await Session.SendMutationAsync(id==0?HttpMethod.Post:HttpMethod.Put,id==0?$"api/{ResourceId}":$"api/{ResourceId}/{id}",selected);message=r.IsSuccessStatusCode?"اطلاعات ذخیره شد.":"ذخیره ناموفق بود؛ ورودی‌ها را بررسی کنید.";Close();await Load();}
async Task Delete(){var id=deleteTarget?["id"]?.GetValue<int>()??0;var r=await Session.SendMutationAsync(HttpMethod.Delete,$"api/{ResourceId}/{id}");message=r.IsSuccessStatusCode?"رکورد حذف شد.":"حذف انجام نشد؛ رکورد وابسته وجود دارد.";deleteTarget=null;await Load();}
async Task Approve(){var id=selected?["id"]?.GetValue<int>()??0;var r=await Session.SendMutationAsync(HttpMethod.Post,$"api/inspections/{id}/approve");message=r.IsSuccessStatusCode?"بازرسی تأیید شد.":"تأیید انجام نشد.";Close();await Load();}
async Task LoadHistory(){showHistory=true;var id=selected?["id"]?.GetValue<int>()??0;var a=await Http.GetFromJsonAsync<JsonArray>($"api/inspections/{id}/approval-history");history=a?.Select(x=>x?.ToJsonString()??"").ToList()??[];}async Task Prev(){page--;await Load();}async Task Next(){page++;await Load();}}
