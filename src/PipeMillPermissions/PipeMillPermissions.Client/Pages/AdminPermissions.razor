@page "/admin/permissions"
@inject HttpClient Http
@inject SessionService Session
<PageTitle>مدیریت دسترسی‌ها</PageTitle>
<header class="page-header"><div><span class="eyebrow">مدیریت سامانه</span><h1>مدیریت دسترسی‌ها</h1><p>دسترسی هر نقش را به منوها، فرم‌ها، کنترل‌ها و APIها مدیریت کنید.</p></div></header>
@if(!Session.Can("admin.permissions.read")){<div class="access-view"><h2>دسترسی غیرمجاز</h2></div>}else{<div class="toolbar"><label for="role">نقش</label><select id="role" @bind="role" @bind:after="Load">@foreach(var r in roles){<option>@r</option>}</select><label for="filter">جستجو</label><input id="filter" @bind="filter" @bind:event="oninput"/></div>@foreach(var group in permissions.Where(x=>string.IsNullOrWhiteSpace(filter)||x.Key.Contains(filter,StringComparison.OrdinalIgnoreCase)||x.Title.Contains(filter)).GroupBy(x=>x.Module)){<section class="permission-group"><h2>@group.Key</h2>@foreach(var p in group){<label class="permission-row"><input type="checkbox" checked="@p.Granted" disabled="@(!p.Active||!Session.Can("admin.permissions.grant"))" @onchange="e=>Change(p,(bool)e.Value!)"/><span><strong>@p.Title</strong><small>@p.Kind · @p.RelatedUi</small></span><code dir="ltr">@p.Key</code></label>}</section>}}
@code { string role="Administrator",filter="";string[] roles=[];List<PermissionDto> permissions=[];protected override async Task OnInitializedAsync(){await Session.RefreshAsync();if(Session.Can("admin.permissions.read")){roles=await Http.GetFromJsonAsync<string[]>("api/admin/roles")??[];if(roles.Length>0)role=roles[0];await Load();}}async Task Load(){permissions=await Http.GetFromJsonAsync<List<PermissionDto>>($"api/admin/permissions?role={Uri.EscapeDataString(role)}")??[];}async Task Change(PermissionDto p,bool granted){await Session.SendMutationAsync(HttpMethod.Post,"api/admin/grants",new GrantRequest(role,p.Key,granted));await Load();}}
