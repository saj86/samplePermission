@page "/login"
@inject HttpClient Http
@inject SessionService Session
@inject NavigationManager Navigation
<PageTitle>ورود</PageTitle>
<div class="auth-shell"><section class="auth-intro"><div class="auth-brand"><span><svg aria-hidden="true" viewBox="0 0 32 32"><path d="M4 25V12l6-4v7l6-4v4l6-4v14M2 25h28M8 25v-4m6 4v-4m6 4v-4m6 4V7h3v18"/></svg></span><div><strong>فولاد پایا</strong><small>سامانه یکپارچه عملیات</small></div></div><div class="auth-message"><span class="eyebrow">مدیریت هوشمند کارخانه</span><h2>یک نمای امن برای همهٔ عملیات تولید</h2><p>تجهیزات، سفارش‌های تولید و کنترل کیفیت را در یک محیط ساده و مبتنی بر دسترسی مدیریت کنید.</p><ul><li>دسترسی دقیق مبتنی بر نقش</li><li>ثبت و پیگیری عملیات در لحظه</li><li>رابط فارسی و سازگار با همهٔ دستگاه‌ها</li></ul></div><small class="auth-version">نسخه نمایشی · .NET 10</small></section><section class="auth-card"><div class="auth-card-head"><span class="lock-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 10V7a5 5 0 0 1 10 0v3m-12 0h14v11H5V10Zm7 4v3"/></svg></span><span class="eyebrow">ورود امن</span><h1>به سامانه خوش آمدید</h1><p>برای ادامه، اطلاعات حساب سازمانی خود را وارد کنید.</p></div><EditForm Model="model" OnValidSubmit="SubmitLogin"><DataAnnotationsValidator/><div class="field"><label for="username">نام کاربری</label><div class="input-wrap"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z"/></svg><InputText id="username" @bind-Value="model.UserName" autocomplete="username" placeholder="نام کاربری خود را وارد کنید"/></div><ValidationMessage For="() => model.UserName"/></div><div class="field"><label for="password">گذرواژه</label><div class="input-wrap"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 10V7a5 5 0 0 1 10 0v3m-12 0h14v11H5V10Z"/></svg><InputText id="password" type="password" @bind-Value="model.Password" autocomplete="current-password" placeholder="گذرواژه خود را وارد کنید"/></div><ValidationMessage For="() => model.Password"/></div>@if(error is not null){<div class="alert alert-danger" role="alert">@error<br/><small>نام کاربری و گذرواژه را بررسی و دوباره تلاش کنید.</small></div>}<button class="btn btn-primary auth-submit" disabled="@busy"><span>@(busy?"در حال بررسی…":"ورود به سامانه")</span>@if(!busy){<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>}</button></EditForm><div class="demo-note"><strong>حساب‌های محیط توسعه</strong><span><code>admin</code> · <code>viewer</code> · <code>inspector</code></span></div></section></div>
@code { LoginRequest model=new();string? error;bool busy;async Task SubmitLogin(){busy=true;var r=await Http.PostAsJsonAsync("api/auth/login",model);if(r.IsSuccessStatusCode){await Session.RefreshAsync();Navigation.NavigateTo("/");}else error="نام کاربری یا گذرواژه نادرست است.";busy=false;} }
