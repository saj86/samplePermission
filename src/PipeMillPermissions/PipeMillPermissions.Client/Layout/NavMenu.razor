@inject SessionService Session
<header class="brand"><span class="brand-mark"><svg aria-hidden="true" viewBox="0 0 32 32"><path d="M4 25V12l6-4v7l6-4v4l6-4v14M2 25h28M8 25v-4m6 4v-4m6 4v-4m6 4V7h3v18"/></svg></span><div><strong>فولاد پایا</strong><small>سامانه یکپارچه عملیات</small></div></header>
<nav aria-label="منوی اصلی"><NavLink href="/" Match="NavLinkMatch.All"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 13h6V4H4v9Zm0 7h6v-4H4v4Zm10 0h6v-9h-6v9Zm0-16v4h6V4h-6Z"/></svg><span>نمای کلی</span></NavLink>
@foreach(var group in ClientFeatureCatalog.Modules.GroupBy(x=>x.MenuGroup)){<div class="nav-group">@group.Key</div>@foreach(var module in group.Where(x=>Session.Can($"{x.ResourceId}.list"))){<NavLink href="@module.Route">@if(module.ResourceId=="equipment"){<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M14.7 6.3a4 4 0 0 0-5-5L12 3.6 9.6 6 7.3 3.7a4 4 0 0 0 5 5L4 17l3 3 7.7-8.3a4 4 0 0 0 0-5.4Z"/></svg>}else if(module.ResourceId=="production-orders"){<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M9 5h11M9 12h11M9 19h11M4 5h.01M4 12h.01M4 19h.01"/></svg>}else{<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 11 2 2 4-5M5 3h14v18H5V3Zm4 15h6"/></svg>}<span>@module.Title</span></NavLink>}}
@if(Session.Can("admin.permissions.read")){<div class="nav-group">مدیریت سامانه</div><NavLink href="/admin/permissions"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 15a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8-3 2-1-2-4-2 .5L16 6l-.5-2h-5L10 6 8 7.5 6 7l-2 4 2 1v2l-2 1 2 4 2-.5L10 20l.5 2h5l.5-2 2-1.5 2 .5 2-4-2-1v-2Z"/></svg><span>مدیریت دسترسی‌ها</span></NavLink>}</nav>
<div class="sidebar-foot"><span class="system-health"><i aria-hidden="true"></i>سامانه فعال است</span><small>نسخه نمایشی ۱.۰</small></div>
@code { protected override async Task OnInitializedAsync(){Session.Changed+=StateHasChanged;await Session.RefreshAsync();} }
