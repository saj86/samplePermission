@inject SessionService Session
<header class="brand"><span class="brand-mark">PM</span><div><strong>فولاد پایا</strong><small>مدیریت عملیات</small></div></header>
<nav aria-label="منوی اصلی"><NavLink href="/" Match="NavLinkMatch.All">نمای کلی</NavLink>
@foreach(var group in ClientFeatureCatalog.Modules.GroupBy(x=>x.MenuGroup)){<div class="nav-group">@group.Key</div>@foreach(var module in group.Where(x=>Session.Can($"{x.ResourceId}.list"))){<NavLink href="@module.Route">@module.Title</NavLink>}}
@if(Session.Can("admin.permissions.read")){<div class="nav-group">مدیریت</div><NavLink href="/admin/permissions">مدیریت دسترسی‌ها</NavLink>}</nav>
@code { protected override async Task OnInitializedAsync(){Session.Changed+=StateHasChanged;await Session.RefreshAsync();} }
