@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="top-context"><span class="status-dot" aria-hidden="true"></span><span>سامانه عملیات کارخانه</span></div>
            <a class="account-link" href="/login"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z"/></svg><span>حساب کاربری</span></a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    خطایی رخ داده است.
    <a href="." class="reload">بارگذاری دوباره</a>
    <span class="dismiss">×</span>
</div>
