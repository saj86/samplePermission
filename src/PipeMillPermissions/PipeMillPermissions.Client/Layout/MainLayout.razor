@inherits LayoutComponentBase
@inject SessionService Session
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="top-context"><span class="status-dot" aria-hidden="true"></span><span>سامانه عملیات کارخانه</span></div>
            @if (Session.Current.IsAuthenticated)
            {
                <div class="account-actions"><span class="signed-user"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z"/></svg>@Session.Current.DisplayName</span><button class="logout-button" @onclick="Logout">خروج</button></div>
            }
            else
            {
                <a class="account-link" href="/login"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z"/></svg><span>ورود</span></a>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync() { Session.Changed += StateHasChanged; await Session.RefreshAsync(); }
    private async Task Logout() { await Session.SendMutationAsync(HttpMethod.Post, "api/auth/logout"); await Session.RefreshAsync(); Navigation.NavigateTo("/login", true); }
}

<div id="blazor-error-ui" data-nosnippet>
    خطایی رخ داده است.
    <a href="." class="reload">بارگذاری دوباره</a>
    <span class="dismiss">×</span>
</div>
